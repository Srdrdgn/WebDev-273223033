# Every variable the app reads, with harmless placeholders. Real values go into Render/hosting, never into git.
PORT=3000

# Neon dashboard -> Connect -> connection string (postgresql://.../neondb?sslmode=require)
DATABASE_URL=postgres://user:password@host/dbname

# Generate locally with: openssl rand -hex 32
SESSION_SECRET=change-me

# Public URL of the app (local: http://localhost:3000, Render: https://<service>.onrender.com)
PUBLIC_BASE_URL=http://localhost:3000

# Optional Google OAuth credentials (from Google Cloud Console; app can run without them)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional model key (from Google AI Studio; app falls back to raw notes without it)
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash

# Optional MCP token (if MCP calls authenticated service endpoints)
MCP_TOKEN=